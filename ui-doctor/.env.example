# Servidor
PORT=8787
HOST=127.0.0.1
# Diretório de dados (SQLite + capturas). Padrão: ./data
UIDOCTOR_DATA_DIR=./data
# Build do frontend servido pelo próprio servidor em produção
UIDOCTOR_WEB_DIST=../web/dist

# Fila de análises simultâneas
UIDOCTOR_CONCURRENCY=2
# Criações (análises, uploads, propostas) por minuto e por IP
UIDOCTOR_RATE_LIMIT=20

# Captura
UIDOCTOR_NAV_TIMEOUT_MS=25000
UIDOCTOR_MAX_CAPTURE_HEIGHT=8000
# Em produção, rode como usuário não-root e ative o sandbox do Chromium
UIDOCTOR_CHROMIUM_SANDBOX=false
# UIDOCTOR_CHROMIUM_PATH=/caminho/para/chromium
# Proxy HTTP corporativo (opcional). A validação anti-SSRF continua ativa.
# UIDOCTOR_UPSTREAM_PROXY=http://proxy.interno:3128

# IA (opcional). Sem chave, a análise usa apenas as regras medidas.
# ANTHROPIC_API_KEY=
UIDOCTOR_AI_MODEL=claude-opus-5-5
# UIDOCTOR_DISABLE_AI=1

# SOMENTE desenvolvimento/testes: libera hosts privados específicos (host:porta, separados por vírgula)
# UIDOCTOR_ALLOW_PRIVATE_HOSTS=127.0.0.1:4599

# CORS, se o frontend for servido em outra origem
# UIDOCTOR_CORS_ORIGIN=https://app.exemplo.com
